{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dashboard-app",
  "version": "0.1.0",
  "identifier": "com.dashboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dashboard-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCOUEyNDJBRDVDRTdGNjIKUldSaWY4N1ZLaVNhYStnN25DV1JxbnJSUkFyaWxlSjNRbmhGYVBrN1VnNWZEZ09IUUdxNVZ2bVYK",
      "endpoints": [
        "https://github.com/kamranmuazzam/edudash-tauri/releases/latest/download/latest.json"
      ]
    }
  }
}
